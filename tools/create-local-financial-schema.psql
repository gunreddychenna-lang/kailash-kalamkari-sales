-- KK SALES: isolated self-hosted development financial schema
-- Derived from read-only PostgreSQL 17.6 metadata export, 23 Nov 2026.
-- Destination ONLY: kk_sales_dev on 127.0.0.1:55432
-- Never run against production Supabase or the local 5432 service.
-- Idempotent for schema creation; no ALTER/DROP/TRUNCATE/DELETE.
\set ON_ERROR_STOP on
SELECT CASE WHEN current_database() = 'kk_sales_dev'
                AND inet_server_port() = 55432
                AND current_user = 'kk_dev_admin'
                AND inet_server_addr() = '127.0.0.1'::inet
            THEN 'true' ELSE 'false' END AS kk_target_valid \gset
\if :kk_target_valid
\else
\echo 'REFUSING: this migration is only for isolated kk_sales_dev on 127.0.0.1:55432 as kk_dev_admin'
\quit 3
\endif
BEGIN;
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '20s';

CREATE TABLE IF NOT EXISTS public.sales (
    id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    sl_no numeric DEFAULT 0,
    store_name text DEFAULT 'Main Branch',
    bill_no text NOT NULL,
    item_name text,
    bill_date date,
    qty numeric DEFAULT 1,
    rate numeric DEFAULT 0,
    discount numeric DEFAULT 0,
    amount numeric NOT NULL,
    agent_name text,
    pay_mode text,
    sale_type text,
    acc_name text,
    created_at timestamptz DEFAULT now(),
    bank_account text DEFAULT 'Cash',
    sm_name text,
    customer_phone text DEFAULT '',
    customer_name text DEFAULT 'Walk-in Customer',
    line_id text
);
CREATE INDEX IF NOT EXISTS idx_sales_agent ON public.sales (agent_name);
CREATE INDEX IF NOT EXISTS idx_sales_bill_date ON public.sales (bill_date);
CREATE INDEX IF NOT EXISTS idx_sales_bill_no ON public.sales (bill_no);
CREATE INDEX IF NOT EXISTS idx_sales_customer_name ON public.sales (customer_name);
CREATE INDEX IF NOT EXISTS idx_sales_customer_phone ON public.sales (customer_phone);
CREATE INDEX IF NOT EXISTS idx_sales_date ON public.sales (bill_date);
CREATE UNIQUE INDEX IF NOT EXISTS idx_sales_line_id ON public.sales (line_id);
CREATE INDEX IF NOT EXISTS idx_sales_store_name ON public.sales (store_name);

-- Deliberately no unique or primary-key constraint: source has none,
-- and historical duplicate invoice references require reconciliation.
CREATE TABLE IF NOT EXISTS public.bills_master (
    bill_no text,
    bill_date date,
    branch text,
    sm_name text,
    channel text,
    customer_name text,
    customer_phone text,
    bill_amount numeric,
    total_qty numeric
);

CREATE TABLE IF NOT EXISTS public.receivables (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    bill_no text NOT NULL,
    bill_date date,
    account_name text DEFAULT 'Split Payment',
    sales_agent text DEFAULT 'No Agent',
    amount numeric NOT NULL DEFAULT 0,
    bank_account text NOT NULL DEFAULT 'Cash',
    created_at timestamptz DEFAULT now(),
    store_name text
);
COMMIT;

-- No import is performed here. Expected counts remain zero before restore.
SELECT 'sales' AS table_name, count(*)::bigint AS row_count FROM public.sales
UNION ALL SELECT 'bills_master',count(*)::bigint FROM public.bills_master
UNION ALL SELECT 'receivables',count(*)::bigint FROM public.receivables;
