# Kailash Kalamkari Sales Management Portal — Environment Configuration
# Copy to .env for local runs. NEVER commit .env or service account keys to GitHub.

APP_ENV=development
APP_SECRET_KEY=replace-with-64-char-random-hex-from-openssl-rand-hex-32
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
SYNC_LOCK_TTL_SECONDS=600

# Database: Use PostgreSQL in staging/production (e.g. Neon or local Docker Postgres)
# Example PostgreSQL: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/kailash_portal?sslmode=require
DATABASE_URL=sqlite:///./kailash_portal.db

